---
layout: none
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.noindex != true" | where_exp: "p", "p.sitemap != false" %}
{%- for p in pages %}
  <url><loc>{{ site.url }}{{ p.url }}</loc></url>
{%- endfor %}
{%- for s in site.stories %}
  <url><loc>{{ site.url }}{{ s.url }}</loc>{% if s.date %}<lastmod>{{ s.updated | default: s.date | date: "%Y-%m-%d" }}</lastmod>{% endif %}</url>
{%- endfor %}
{%- for i in site.itineraries %}
  <url><loc>{{ site.url }}{{ i.url }}</loc></url>
{%- endfor %}
</urlset>
